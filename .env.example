# Copy to .env and fill in. Never commit .env.

# --- matcha: server ---
MATCHA_HOST=127.0.0.1
MATCHA_PORT=8080
MATCHA_DEBUG=

# --- matcha: auth ---
# Leave UNSET when bound to 127.0.0.1 - the network is the boundary and the
# guard is a no-op. Only set this if you expose the matcha off-box, then send
# `Authorization: Bearer <token>` from the bridge.
# MATCHA_TOKEN=

# --- matcha: cache ---
# MATCHA_DB=matcha/matches.db
# MATCHA_MISS_TTL=604800
# MATCHA_SEARCH_LIMIT=8

# --- Spotify (catalogue search only) ---
# Client-credentials flow: no user authorization, no Premium, and NOT subject to
# the 5-user dev-mode cap. This pair is all the matcha ever needs.
# The secret is server-side only - never ship it to an agent.
# See DEPENDENCIES.md Part 7.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- sync engine ---
# Canonical crossfade for the whole session, in ms. Every client must agree;
# mismatched values desync track boundaries cumulatively. 0 disables crossfade.
# Yours: pear-desktop secondsBeforeEnd=6 -> 6000. Set Spotify to match.
SYNC_CROSSFADE_MS=6000
# 1 = refuse clients whose crossfade disagrees, 0 = warn and continue
SYNC_CROSSFADE_STRICT=1
